def get_menu(lang):
    t = TEXTS[lang]
    return ReplyKeyboardMarkup(
        [
            [t["song"], t["lyrics"]],
            [t["beat"], t["language"]],
        ],
        resize_keyboard=True,
    )

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    lang = context.user_data.get("lang", "ru")
    await update.message.reply_text(
        TEXTS[lang]["welcome"],
        reply_markup=get_menu(lang),
    )

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = update.message.text.strip()
    lang = context.user_data.get("lang", "ru")
    t = TEXTS[lang]

    if text == "🌍 Язык" or text == "🌍 Til" or text == "🌍 Забон":
        await update.message.reply_text(
            "🇷🇺 Русский\n🇺🇿 O‘zbekcha\n🇹🇯 Тоҷикӣ"
        )
        context.user_data["mode"] = "language"
        return

    if context.user_data.get("mode") == "language":
        languages = {
            "🇷🇺 Русский": "ru",
            "🇺🇿 O‘zbekcha": "uz",
            "🇹🇯 Тоҷикӣ": "tg",
        }
        if text in languages:
            context.user_data["lang"] = languages[text]
            context.user_data["mode"] = None
            new_lang = languages[text]
            await update.message.reply_text(
                TEXTS[new_lang]["welcome"],
                reply_markup=get_menu(new_lang),
            )
        else:
            await update.message.reply_text("Выбери: 🇷🇺 Русский, 🇺🇿 O‘zbekcha или 🇹🇯 Тоҷикӣ")
        return

    actions = {
        t["song"]: ("song", t["ask_song"]),
        t["lyrics"]: ("lyrics", t["ask_lyrics"]),
        t["beat"]: ("beat", t["ask_beat"]),
    }

    if text in actions:
        mode, question = actions[text]
        context.user_data["mode"] = mode
        await update.message.reply_text(question)
        return

    mode = context.user_data.get("mode")
    if mode in ("song", "lyrics", "beat"):
        await update.message.reply_text(
            t["received"] + text + "\n\n" + t["help"]
        )
        context.user_data["mode"] = None
    else:
        await update.message.reply_text(t["welcome"], reply_markup=get_menu(lang))

def main():
    if not TOKEN:
        raise RuntimeError("Set TELEGRAM_BOT_TOKEN in Render environment variables")

    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    app.run_polling()

if __name__ == "__main__":
    main()
